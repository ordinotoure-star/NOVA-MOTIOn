        "id",
        "userId",
        "planId",
        "billingCycle",
        "paymentMethod",
        "status",
        "renewsAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "AIModel": {
      "title": "AIModel",
      "description": "Platform AI engine configuration and operational telemetry.",
