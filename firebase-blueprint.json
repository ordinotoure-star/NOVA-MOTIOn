      "required": [
        "id",
        "userId",
        "type",
        "amount",
        "balanceAfter",
        "description",
        "paymentMethod",
        "createdAt"
      ]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription lifecycle record tying user to active tier and billing cycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
