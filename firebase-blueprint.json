{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated NOVA MOTION AI studio user profile and plan governance record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "role": {
          "type": "string",
          "enum": ["free", "basic", "plus", "pro", "annual_1", "annual_2", "admin", "super_admin"]
        },
        "planId": {
          "type": "string",
          "enum": ["free", "basic", "plus", "pro", "annual_1", "annual_2"]
        },
        "emailVerified": { "type": "boolean" },
        "mfaEnabled": { "type": "boolean" },
        "suspended": { "type": "boolean" },
        "firstMonthDiscountUsed": { "type": "boolean" },
        "language": { "type": "string", "enum": ["fr", "en"] },
        "organization": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "email",
        "fullName",
        "role",
        "planId",
        "emailVerified",
        "mfaEnabled",
        "suspended",
        "firstMonthDiscountUsed",
        "language",
        "organization",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Trusted RBAC registry mapping privileged Firebase UIDs to platform admin status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "enum": ["admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Wallet": {
      "title": "Wallet",
