        "userId",
        "balance",
        "reserved",
        "monthlySpent",
        "dailyLimit",
        "lowBalanceThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Immutable credit ledger record for grants, reservations, debits, refunds, and top-ups.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": {
          "type": "string",
